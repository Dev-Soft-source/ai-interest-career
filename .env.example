# Copy to .env and fill in values.

# LLM: openai (default) or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Google Sheets — JSON key file for a service account with access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
SPREADSHEET_ID=

RESPONSES_SHEET_NAME=Responses
RESULTS_SHEET_NAME=Results

# Column names must match your Tally → Sheets headers
EMAIL_COLUMN=email
PROCESSED_COLUMN=processed
# Comma-separated in .env is not parsed as list by pydantic-settings for list fields;
# use defaults (Q1,Q2,Q3) in config or override in code if needed.

# Optional: path to jobs list JSON: {"jobs": ["Role A", "Role B", ...]}
# JOBS_FILE=data/jobs.json

# Local demo without Google (uses in-memory sample row; still needs LLM key)
# USE_MOCK_SHEETS=true
