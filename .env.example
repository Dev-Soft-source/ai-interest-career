# Copy to .env and fill in values.

# LLM: gemini (recommended) or openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Sheets — JSON key file for a service account with access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
SPREADSHEET_ID=

# Tab with Tally answers (email + A1..F8). Must match the sheet tab name exactly.
RESPONSES_SHEET_NAME=Responses
# Optional archive tab written after each assessment (not used to load the results page).
RESULTS_SHEET_NAME=Results
# WRITE_RESULTS_SHEET=false  # skip Results tab if you only need Responses + the web UI

# Column names must match your Tally → Sheets headers on the Responses tab
EMAIL_COLUMN=email
PROCESSED_COLUMN=processed
# Optional comma-separated override; default is A1..F8 (48 items)
# QUESTION_COLUMNS=A1,A2,A3,...,F8

# Results tab columns written by the backend
# RESULTS_USER_VECTOR_COLUMN=user_dimension_vector
# RESULTS_TOP_JOBS_COLUMN=top_jobs
# RESULTS_SUMMARY_COLUMN=summary

# Structured job catalog (6D vectors). Default when unset: data/jobs_30_core.json
# JOB_SET=core_30
# JOB_SET=client_40
# JOBS_FILE=data/jobs_30_core.json

# Ranking output size (fixed at 5 for production)
TOP_K=5

# Optional: restrict scoring to core job_id values from the manual template
# ENFORCE_CORE_JOB_WHITELIST=false
# CORE_JOB_WHITELIST=ARTISAN,DEV_WEB,DATA_ANALYST

# Local demo without Google (uses in-memory sample row; still needs LLM key)
# USE_MOCK_SHEETS=true
